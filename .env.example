# Environment Variables Configuration
# Copy this file to .env and fill in your values

# Data Configuration
DATA_FOLDER=./DATA
TRAIN_DATA_PATH=./DATA/clean_data_train.txt
TEST_DATA_PATH=./DATA/clean_data_test.txt
OUTPUT_FOLDER=./outputs

# Training Configuration
TRAIN_END_DATE=1995-08-22
TIME_WINDOWS=1m,5m,15m
RANDOM_STATE=42
MODELS=xgboost,lightgbm
EVALUATION_METRICS=rmse,mse,mae,mape

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database (if applicable)
DB_URL=sqlite:///./autoscaling.db

# Feature Configuration
ENABLE_ANOMALY_DETECTION=true
ANOMALY_THRESHOLD=0.95
DDoS_DETECTION_ENABLED=true
DDoS_THRESHOLD=0.8

# Model Training
MODEL_SAVE_PATH=./models
CHECKPOINT_INTERVAL=10
VALIDATION_SPLIT=0.2

# Streamlit Dashboard
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
