# ===== AUTOSCALING ANALYSIS PROJECT =====
PYTHONIOENCODING=utf-8

# Data paths
DATA_FOLDER=./DATA
TRAIN_DATA_PATH=./DATA/train.txt
TEST_DATA_PATH=./DATA/test.txt
OUTPUT_FOLDER=./outputs

# Time series parameters
TIME_WINDOWS=1m,5m,15m
TRAIN_END_DATE=1995-08-22
TEST_START_DATE=1995-08-23

# Model parameters
RANDOM_STATE=42
TEST_SIZE=0.2
VALIDATION_SIZE=0.1

# Models to train (comma-separated)
MODELS=arima,sarima,lstm,xgboost,lightgbm

# Metrics
EVALUATION_METRICS=rmse,mse,mae,mape

# Scaling optimization
SCALE_OUT_THRESHOLD=0.75
SCALE_IN_THRESHOLD=0.30
COOLDOWN_MINUTES=10
CONSECUTIVE_THRESHOLD=5

# Cost estimation
UNIT_COST_PER_SERVER_HOUR=0.10

# API & Dashboard
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Logging
LOG_LEVEL=INFO
DEBUG=False